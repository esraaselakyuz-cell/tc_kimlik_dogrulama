<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Üst bronz şerit: resmi belge üst bandına gönderme -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/gold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T.C. No Doğrulama"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="@color/ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="11 haneyi resmî kontrol algoritmasına göre denetler. Cihaz dışına hiçbir veri gönderilmez."
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_muted" />

            <!-- İnce ayraç: bölüm geçişi -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/cell_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kimlik Numarası"
                android:textSize="13sp"
                android:textColor="@color/ink_muted" />

            <!-- 11 basılı-kutu hane girişi: resmi belgelerdeki hane kutularına gönderme -->
            <LinearLayout
                android:id="@+id/digitContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/d1"
                    style="@style/DigitCell"
                    android:layout_marginStart="0dp" />
                <EditText android:id="@+id/d2" style="@style/DigitCell" />
                <EditText android:id="@+id/d3" style="@style/DigitCell" />
                <EditText android:id="@+id/d4" style="@style/DigitCell" />
                <EditText android:id="@+id/d5" style="@style/DigitCell" />
                <EditText android:id="@+id/d6" style="@style/DigitCell" />
                <EditText android:id="@+id/d7" style="@style/DigitCell" />
                <EditText android:id="@+id/d8" style="@style/DigitCell" />
                <EditText android:id="@+id/d9" style="@style/DigitCell" />
                <EditText android:id="@+id/d10" style="@style/DigitCell" />
                <EditText
                    android:id="@+id/d11"
                    style="@style/DigitCell"
                    android:layout_marginEnd="0dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDogrula"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button"
                android:text="Doğrula"
                android:textAllCaps="false"
                android:textColor="@color/gold_soft"
                android:textSize="16sp"
                android:letterSpacing="0.02"
                android:elevation="0dp" />

            <!-- Sonuç satırı: nokta gösterge + mesaj -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dotSonuc"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tvSonuc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="14sp"
                    android:textColor="@color/ink" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
